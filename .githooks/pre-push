#!/bin/sh

# Fast pre-push gate: icon sync check, localized strings lint, and
# workspace sanity. Installed by `mise run bootstrap` via core.hooksPath.
# Bypass with `git push --no-verify` only when you know why.

set -eu

if ! command -v mise >/dev/null 2>&1; then
  echo "pre-push: mise is not on PATH, and it is this repo's task runner." >&2
  echo "pre-push: install it (https://mise.jdx.dev), or run scripts/verify-fast.sh" >&2
  echo "pre-push: plus the three sync --check passes yourself, then --no-verify." >&2
  exit 1
fi

if ! mise run verify-fast; then
  echo "" >&2
  echo "pre-push: mise run verify-fast failed; push aborted." >&2
  echo "pre-push: run 'mise run doctor' if your environment looks off." >&2
  exit 1
fi
