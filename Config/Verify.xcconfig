// Verification-only overrides.
// Keep this file narrow so simulator verification cannot inherit private local
// bundle identifiers, while embedded frameworks keep their own identifiers.

PUTIO_APP_IDENTIFIER = io.put.dev
PUTIO_APP_DISPLAY_NAME = put.io
PUTIO_PRIMARY_APP_ICON = AppIconDev
PUTIO_DEVELOPMENT_TEAM =

// Baselines are recorded with the brand faces bundled, so the visual suite can
// see typography regressions — it could not while these were excluded, which is
// why three consecutive type PRs (#37, #42, #43) moved no baseline. Recording
// therefore requires the licensed fonts: run `make fonts-setup` first.
PUTIO_BUNDLE_BRAND_FONTS = YES

// Playback fixtures for the mocked e2e walk. Only set here, so a distributed
// build never carries them (see Putio/E2EMedia/ATTRIBUTION.md).
PUTIO_BUNDLE_E2E_MEDIA = YES
