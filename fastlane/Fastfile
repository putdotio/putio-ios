require "shellwords"
require "fileutils"
require "tmpdir"
require "json"

default_platform(:ios)
opt_out_usage

# Apple caps each locale/display-type screenshot set at 10.
APP_STORE_SCREENSHOT_LIMIT = 10

# Deliver's own wait for App Store Connect to process the upload — per attempt,
# not per run. Deliver::UploadScreenshots#upload_screenshots recurses with
# `tries: 5` and hands each attempt the full timeout, so the real worst case is
# five times this number.
#
# That matters because overwrite_screenshots deletes the existing set before
# uploading: a job killed part way through leaves the live listing blank. The
# workflow's timeout-minutes must therefore cover 5 x this plus setup, and the
# two are documented against each other. At 900s that is 75 minutes of upload
# against a 90 minute job.
SCREENSHOT_PROCESSING_TIMEOUT = 900

# The version string App Store Connect currently has open for editing, or nil.
# Screenshots always attach to this version regardless of what is passed to
# upload_to_app_store, so the screenshots lane compares against it rather than
# trusting its own input.
def resolve_editable_app_store_version(app_identifier)
  require "spaceship"

  api_key = lane_context[SharedValues::APP_STORE_CONNECT_API_KEY]
  UI.user_error!("App Store Connect API key is not configured.") if api_key.nil?

  Spaceship::ConnectAPI.auth(
    key_id: api_key[:key_id],
    issuer_id: api_key[:issuer_id],
    key: api_key[:key],
    duration: api_key[:duration],
    in_house: api_key[:in_house]
  )

  app = Spaceship::ConnectAPI::App.find(app_identifier)
  UI.user_error!("No App Store Connect app found for #{app_identifier}.") if app.nil?

  app.get_edit_app_store_version(platform: Spaceship::ConnectAPI::Platform::IOS)&.version_string
end

def require_ci!
  UI.user_error!("This fastlane setup is CI-only. Use the GitHub Actions beta or release workflow.") unless is_ci
end

def first_present(*values)
  values.find { |value| !value.to_s.empty? }
end

def fastlane_bool(value, default:)
  return default if value.to_s.empty?

  %w[1 true yes on].include?(value.to_s.downcase)
end

def normalized_version(value)
  candidate = value.to_s.strip
  return nil if candidate.empty?

  candidate.sub(/\Av/, "")
end

def generated_build_number
  Time.now.utc.strftime("%y%m%d%H%M")
end

def resolved_build_number(*values)
  first_present(*values, generated_build_number)
end

def resolved_wait_timeout(*values)
  raw_value = first_present(*values)
  return nil if raw_value.to_s.empty?

  Integer(raw_value, 10)
rescue ArgumentError
  UI.user_error!("Wait timeout must be an integer number of seconds")
end

def configured_testflight_groups(*values, default_group: "Beta")
  groups = first_present(*values).to_s.split(",").map(&:strip).reject(&:empty?)
  groups.empty? ? [default_group] : groups
end

def configure_app_store_connect_api_key
  app_store_connect_api_key(
    issuer_id: ENV["APPSTORE_CONNECT_ISSUER_ID"],
    key_id: ENV["APPSTORE_CONNECT_KEY_ID"],
    key_filepath: ENV["APPSTORE_CONNECT_KEY_FILEPATH"]
  )
end

def setup_putio_ci_keychain
  run_suffix = [ENV["GITHUB_RUN_ID"], ENV["GITHUB_RUN_ATTEMPT"]]
    .reject { |value| value.to_s.empty? }
    .join("-")
  default_keychain_name = run_suffix.empty? ? "putio-ios-ci.keychain" : "putio-ios-ci-#{run_suffix}.keychain"
  default_keychain_password = run_suffix.empty? ? "putio-ios-ci" : "putio-ios-ci-#{run_suffix}"

  keychain_name = first_present(ENV["PUTIO_CI_KEYCHAIN_NAME"], default_keychain_name)
  keychain_password = first_present(ENV["PUTIO_CI_KEYCHAIN_PASSWORD"], default_keychain_password)

  create_keychain(
    name: keychain_name,
    password: keychain_password,
    default_keychain: true,
    unlock: true,
    timeout: 3600,
    lock_when_sleeps: true,
    lock_after_timeout: false,
    add_to_search_list: true,
    require_create: true
  )

  ENV["MATCH_KEYCHAIN_NAME"] = keychain_name
  ENV["MATCH_KEYCHAIN_PASSWORD"] = keychain_password
end

def with_temporary_file_state(paths)
  snapshots = paths.to_h do |path|
    absolute_path = File.expand_path(path, File.expand_path("..", __dir__))
    [absolute_path, File.binread(absolute_path)]
  end

  yield
ensure
  snapshots&.each do |path, contents|
    File.binwrite(path, contents)
  end
end

def xcode_build_settings_arguments(keys, extras: {})
  values = keys.to_h do |key|
    [key, ENV[key]]
  end

  values.merge(extras).filter_map do |key, raw_value|
    value = raw_value.to_s
    next if value.empty?

    "#{key}=#{value}"
  end
end

def plist_escape(value)
  value.to_s
    .gsub("&", "&amp;")
    .gsub("<", "&lt;")
    .gsub(">", "&gt;")
    .gsub('"', "&quot;")
end

def write_export_options_plist(path:, method:, team_id:, provisioning_profiles:)
  provisioning_entries = provisioning_profiles.map do |bundle_identifier, profile_name|
    <<~ENTRY
      <key>#{plist_escape(bundle_identifier)}</key>
      <string>#{plist_escape(profile_name)}</string>
    ENTRY
  end.join

  File.write(path, <<~PLIST)
    <?xml version="1.0" encoding="UTF-8"?>
    <!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "https://www.apple.com/DTDs/PropertyList-1.0.dtd">
    <plist version="1.0">
    <dict>
      <key>method</key>
      <string>#{plist_escape(method)}</string>
      <key>signingStyle</key>
      <string>manual</string>
      <key>teamID</key>
      <string>#{plist_escape(team_id)}</string>
      <key>provisioningProfiles</key>
      <dict>
    #{provisioning_entries.chomp}
      </dict>
    </dict>
    </plist>
  PLIST
end

def configure_release_distribution_signing
  app_identifier = ENV["PUTIO_APP_IDENTIFIER"].to_s
  development_team = ENV["PUTIO_DEVELOPMENT_TEAM"].to_s
  return if app_identifier.empty? || development_team.empty?

  update_code_signing_settings(
    path: "Putio.xcodeproj",
    use_automatic_signing: false,
    sdk: "iphoneos*",
    team_id: development_team,
    targets: ["Putio"],
    build_configurations: ["Release"],
    code_sign_identity: "Apple Distribution",
    profile_name: "match AppStore #{app_identifier}",
    bundle_identifier: app_identifier
  )
end

def archive_and_export_ios_app(output_path: nil)
  repo_root = File.expand_path("..", __dir__)
  app_identifier = ENV.fetch("PUTIO_APP_IDENTIFIER")
  development_team = ENV.fetch("PUTIO_DEVELOPMENT_TEAM")
  profile_name = "match AppStore #{app_identifier}"

  Dir.mktmpdir("putio-ios-build-") do |tmpdir|
    archive_path = File.join(tmpdir, "Putio.xcarchive")
    export_path = File.join(tmpdir, "export")
    export_options_path = File.join(tmpdir, "ExportOptions.plist")

    FileUtils.mkdir_p(export_path)
    write_export_options_plist(
      path: export_options_path,
      method: "app-store",
      team_id: development_team,
      provisioning_profiles: {
        app_identifier => profile_name
      }
    )

    # These env values are passed as `xcodebuild NAME=value` command-line build
    # settings, which override the xcconfig default — unlike a plain env var,
    # which does not. PUTIO_PRIMARY_APP_ICON lives here so beta (AppIconDev) and
    # release (AppIcon) select their channel icon instead of falling back to
    # Shared.xcconfig's AppIconDev.
    build_settings = xcode_build_settings_arguments(
      %w[
        PUTIO_APP_IDENTIFIER
        PUTIO_PRIMARY_APP_ICON
        PUTIO_DEVELOPMENT_TEAM
        PUTIO_OAUTH_CLIENT_ID
        PUTIO_CHROMECAST_RECEIVER_APP_ID
        PUTIO_INTERCOM_API_KEY
        PUTIO_INTERCOM_APP_ID
        PUTIO_SENTRY_DSN
      ],
      extras: {
        "CODE_SIGN_STYLE" => "Manual",
        "CODE_SIGN_IDENTITY" => "Apple Distribution",
        "PROVISIONING_PROFILE_SPECIFIER" => profile_name
      }
    ).map { |argument| Shellwords.escape(argument) }.join(" ")

    archive_command = [
      "set -o pipefail &&",
      "xcodebuild",
      "-workspace", Shellwords.escape("Putio.xcworkspace"),
      "-scheme", Shellwords.escape("Putio"),
      "-configuration", Shellwords.escape("Release"),
      "-sdk", Shellwords.escape("iphoneos"),
      "-quiet",
      "-archivePath", Shellwords.escape(archive_path),
      build_settings,
      "archive"
    ].reject(&:empty?).join(" ")

    export_command = [
      "/usr/bin/xcodebuild",
      "-exportArchive",
      "-archivePath", Shellwords.escape(archive_path),
      "-exportOptionsPlist", Shellwords.escape(export_options_path),
      "-exportPath", Shellwords.escape(export_path),
      "-quiet"
    ].join(" ")

    Dir.chdir(repo_root) do
      sh(archive_command)
      sh(export_command)
    end

    ipa_path = Dir[File.join(export_path, "*.ipa")].first
    UI.user_error!("Expected an exported ipa in #{export_path}, found none") if ipa_path.to_s.empty?

    preserved_ipa_path = output_path.to_s.empty? ? File.join(Dir.tmpdir, "putio-ios-#{Time.now.utc.strftime('%Y%m%d%H%M%S')}.ipa") : output_path
    FileUtils.cp(ipa_path, preserved_ipa_path)

    return preserved_ipa_path
  end
end

platform :ios do
  lane :beta_archive do |options|
    require_ci!
    setup_putio_ci_keychain

    beta_build_number = resolved_build_number(options[:build_number], ENV["PUTIO_BETA_BUILD_NUMBER"])
    ipa_output_path = first_present(options[:ipa_path], ENV["PUTIO_BETA_IPA_PATH"])
    metadata_output_path = first_present(options[:metadata_path], ENV["PUTIO_BETA_METADATA_PATH"])
    UI.user_error!("Missing ipa output path for beta archive") if ipa_output_path.to_s.empty?
    UI.user_error!("Missing metadata output path for beta archive") if metadata_output_path.to_s.empty?

    configure_app_store_connect_api_key

    match(type: ENV.fetch("MATCH_TYPE", "appstore"), platform: "ios", readonly: true)

    with_temporary_file_state(%w[
      Putio.xcodeproj/project.pbxproj
      Putio/Info.plist
    ]) do
      UI.important("==> Beta archive: preparing signed archive")
      increment_build_number(build_number: beta_build_number)
      configure_release_distribution_signing
      ipa_path = archive_and_export_ios_app(output_path: ipa_output_path)
      app_version = FastlaneCore::IpaFileAnalyser.fetch_app_version(ipa_path)
      archived_build_number = FastlaneCore::IpaFileAnalyser.fetch_app_build(ipa_path)

      File.write(
        metadata_output_path,
        JSON.pretty_generate(
          {
            "app_version" => app_version,
            "build_number" => archived_build_number,
            "ipa_path" => ipa_path
          }
        )
      )

      UI.important("==> Beta archive complete: #{ipa_path}")
      UI.important("==> Beta build metadata: version #{app_version}, build #{archived_build_number}")
    end
  end

  lane :beta_upload do |options|
    require_ci!

    ipa_path = first_present(options[:ipa_path], ENV["PUTIO_BETA_IPA_PATH"])
    UI.user_error!("Missing ipa path for beta upload") if ipa_path.to_s.empty?

    configure_app_store_connect_api_key

    UI.important("==> TestFlight upload: starting transporter upload")
    pilot(
      ipa: ipa_path,
      skip_waiting_for_build_processing: true
    )
    UI.important("==> TestFlight upload: upload finished")
  end

  lane :beta_distribute do |options|
    require_ci!

    beta_app_identifier = ENV.fetch("PUTIO_APP_IDENTIFIER")
    beta_changelog = first_present(options[:changelog], ENV["PUTIO_BETA_CHANGELOG"]).to_s.strip
    beta_groups = configured_testflight_groups(options[:groups], ENV["PUTIO_BETA_GROUPS"])
    beta_app_version = first_present(options[:app_version], ENV["PUTIO_BETA_APP_VERSION"])
    beta_build_number = first_present(options[:build_number], ENV["PUTIO_BETA_BUILD_NUMBER"])
    wait_timeout = resolved_wait_timeout(options[:wait_timeout], ENV["PUTIO_BETA_WAIT_TIMEOUT_DURATION"])

    UI.user_error!("Missing app version for beta distribution") if beta_app_version.to_s.empty?
    UI.user_error!("Missing build number for beta distribution") if beta_build_number.to_s.empty?

    configure_app_store_connect_api_key

    effective_changelog = beta_changelog.empty? ? "Manual beta build #{beta_build_number}" : beta_changelog

    UI.important("==> TestFlight distribution: waiting for App Store Connect processing")
    pilot(
      distribute_only: true,
      app_identifier: beta_app_identifier,
      app_platform: "ios",
      app_version: beta_app_version,
      build_number: beta_build_number,
      distribute_external: true,
      groups: beta_groups,
      changelog: effective_changelog,
      wait_processing_timeout_duration: wait_timeout
    )
    UI.important("==> TestFlight distribution: external rollout finished")
  end

  lane :beta do |options|
    require_ci!

    ipa_output_path = first_present(options[:ipa_path], ENV["PUTIO_BETA_IPA_PATH"], File.join(Dir.tmpdir, "putio-ios-beta.ipa"))
    metadata_output_path = first_present(options[:metadata_path], ENV["PUTIO_BETA_METADATA_PATH"], File.join(Dir.tmpdir, "putio-ios-beta.json"))

    beta_archive(
      build_number: first_present(options[:build_number], ENV["PUTIO_BETA_BUILD_NUMBER"]),
      ipa_path: ipa_output_path,
      metadata_path: metadata_output_path
    )

    metadata = JSON.parse(File.read(metadata_output_path))

    beta_upload(ipa_path: metadata.fetch("ipa_path"))
    beta_distribute(
      app_version: metadata.fetch("app_version"),
      build_number: metadata.fetch("build_number"),
      changelog: first_present(options[:changelog], ENV["PUTIO_BETA_CHANGELOG"]),
      groups: first_present(options[:groups], ENV["PUTIO_BETA_GROUPS"]),
      wait_timeout: first_present(options[:wait_timeout], ENV["PUTIO_BETA_WAIT_TIMEOUT_DURATION"])
    )
  end

  lane :release do |options|
    require_ci!
    setup_putio_ci_keychain

    release_version = normalized_version(first_present(options[:version], ENV["PUTIO_RELEASE_VERSION"]))
    UI.user_error!("Missing release version. Publish a tagged GitHub release or pass PUTIO_RELEASE_VERSION.") if release_version.to_s.empty?

    release_build_number = resolved_build_number(options[:build_number], ENV["PUTIO_RELEASE_BUILD_NUMBER"])
    release_app_identifier = ENV.fetch("PUTIO_APP_IDENTIFIER")

    configure_app_store_connect_api_key
    match(type: ENV.fetch("MATCH_TYPE", "appstore"), platform: "ios", readonly: true)

    with_temporary_file_state(%w[
      Putio.xcodeproj/project.pbxproj
      Putio/Info.plist
    ]) do
      UI.important("==> Release build: preparing signed archive")
      increment_version_number(version_number: release_version)
      increment_build_number(build_number: release_build_number)
      configure_release_distribution_signing
      release_ipa_path = archive_and_export_ios_app
      archived_build_number = FastlaneCore::IpaFileAnalyser.fetch_app_build(release_ipa_path)

      UI.important("==> Release upload: uploading build #{release_version} (#{archived_build_number})")

      upload_to_app_store(
        app_identifier: release_app_identifier,
        app_version: release_version,
        build_number: archived_build_number,
        ipa: release_ipa_path,
        platform: "ios",
        skip_screenshots: true,
        skip_metadata: true,
        submit_for_review: false,
        force: true
      )

      UI.important("==> Release upload complete: build #{release_version} (#{archived_build_number}) is attached to the App Store release train")
    end
  end

  # Uploads the committed marketing images and nothing else.
  #
  # Deliberately separate from `release`, which keeps skip_screenshots: true.
  # Shipping a build and changing the product page are different decisions with
  # different review consequences, and coupling them means every release either
  # silently republishes the listing or silently does not.
  #
  # The images come from `mise run store-images` and are reviewed as an image diff
  # before they land, so by the time this runs the artwork has already been seen
  # by a human. This step only moves it.
  lane :screenshots do |options|
    require_ci!

    app_identifier = ENV.fetch("PUTIO_APP_IDENTIFIER")
    screenshots_path = File.expand_path("screenshots", __dir__)

    UI.user_error!(
      "No screenshots at fastlane/screenshots. Run `mise run store-images` and commit the result."
    ) unless Dir.exist?(screenshots_path)

    locales = Dir.children(screenshots_path).select { |entry| File.directory?(File.join(screenshots_path, entry)) }
    UI.user_error!("fastlane/screenshots has no locale directories.") if locales.empty?

    # A dry run must reject what the real upload would. An unsupported folder
    # name — `en_US` with an underscore, say — holds perfectly valid PNGs and
    # would sail through image validation before deliver rejects the directory.
    require "deliver/languages"
    unsupported = locales.reject { |locale| Deliver::Languages::ALL_LANGUAGES.include?(locale) }
    unless unsupported.empty?
      UI.user_error!(
        "Unsupported locale director#{unsupported.length == 1 ? 'y' : 'ies'}: #{unsupported.sort.join(', ')}. " \
        "App Store Connect expects names like en-US or pt-BR."
      )
    end

    counts = locales.to_h do |locale|
      [locale, Dir.glob(File.join(screenshots_path, locale, "*.{png,jpg,jpeg}")).length]
    end

    empty = counts.select { |_, count| count.zero? }.keys
    UI.user_error!("These locales have no images: #{empty.join(', ')}") unless empty.empty?

    counts.each { |locale, count| UI.important("==> Screenshots: #{locale} has #{count} image(s)") }

    # Counting files with image extensions proves almost nothing: a corrupt PNG
    # or an off-spec size passes that and is only rejected mid-upload. Run
    # deliver's own validator so a green dry run means the set is uploadable.
    require "deliver/app_screenshot"
    require "deliver/app_screenshot_validator"

    errors = []
    per_display_type = Hash.new(0)

    locales.sort.each do |locale|
      Dir.glob(File.join(screenshots_path, locale, "*.{png,jpg,jpeg}")).sort.each do |path|
        screenshot = Deliver::AppScreenshot.new(path, locale)
        Deliver::AppScreenshotValidator.validate(screenshot, errors)
        per_display_type[[locale, screenshot.display_type]] += 1 if screenshot.display_type
      end
    end

    unless errors.empty?
      errors.each { |error| UI.error("#{error.type}: #{error.path} — #{error.debug_info}") }
      UI.user_error!("#{errors.length} screenshot(s) would be rejected by App Store Connect. Re-run `mise run store-images`.")
    end

    # Apple caps a locale/display-type set at 10, and deliver silently skips the
    # rest — a success message over a partially published listing.
    over_limit = per_display_type.select { |_, count| count > APP_STORE_SCREENSHOT_LIMIT }
    unless over_limit.empty?
      over_limit.each do |(locale, display_type), count|
        UI.error("#{locale} / #{display_type}: #{count} screenshots, limit is #{APP_STORE_SCREENSHOT_LIMIT}")
      end
      UI.user_error!("A screenshot set exceeds App Store Connect's per-locale limit; the extras would be dropped silently.")
    end

    UI.important("==> Screenshots: #{counts.values.sum} image(s) validated against App Store Connect specs")

    # The lane defaults to a dry run, not to uploading. An omitted or empty flag
    # must never mean "change the live listing".
    dry_run = fastlane_bool(first_present(options[:dry_run], ENV["PUTIO_SCREENSHOTS_DRY_RUN"]), default: true)

    if dry_run
      UI.important("==> Screenshots: dry run, nothing uploaded")
      next
    end

    # Without an explicit version deliver picks whichever edit version it finds,
    # and the live listing (2.58.0) is far behind what the app now builds. Being
    # implicit here risks publishing artwork against the wrong version.
    # Normalized the same way the release lane does, so `v3.0.0` or a padded
    # workflow input does not fail the guard below against an identical version.
    app_version = normalized_version(first_present(options[:app_version], ENV["PUTIO_SCREENSHOTS_APP_VERSION"]))
    UI.user_error!(
      "Missing app version. Pass app_version: or set PUTIO_SCREENSHOTS_APP_VERSION so the screenshots attach to a known App Store version."
    ) if app_version.to_s.empty?

    configure_app_store_connect_api_key

    # deliver's screenshot uploader ignores app_version entirely — it resolves
    # the editable version itself (upload_screenshots.rb calls
    # get_edit_app_store_version). Combined with overwrite_screenshots, passing a
    # version that is merely *logged* is actively dangerous: a typo would wipe
    # the editable version's artwork while reporting success against another.
    #
    # So resolve the editable version ourselves and require it to match what the
    # operator asked for. The requested version is then a real assertion rather
    # than a label.
    editable_version = normalized_version(resolve_editable_app_store_version(app_identifier))

    UI.user_error!(
      "App Store Connect has no editable iOS version for #{app_identifier}. " \
      "Create the version in App Store Connect first, then re-run."
    ) if editable_version.nil?

    UI.user_error!(
      "Requested #{app_version} but the editable App Store version is #{editable_version}. " \
      "Screenshots always attach to the editable version, so this would have replaced #{editable_version}'s artwork. " \
      "Re-run with app_version: #{editable_version} if that is what you intend."
    ) unless editable_version == app_version

    UI.important("==> Screenshots: uploading #{counts.values.sum} image(s) for #{app_identifier} v#{app_version}")

    upload_to_app_store(
      app_identifier: app_identifier,
      app_version: app_version,
      platform: "ios",
      screenshots_path: screenshots_path,
      # Screenshots only: never touch the binary, the metadata, or the review
      # queue from this lane.
      skip_binary_upload: true,
      skip_metadata: true,
      skip_app_version_update: true,
      submit_for_review: false,
      # Apple appends rather than replaces unless told otherwise, which would
      # leave the 2024 screenshots sitting alongside the new ones.
      overwrite_screenshots: true,
      # Deliver waits an hour by default. overwrite_screenshots deletes before it
      # uploads, so being killed mid-run leaves the listing blank — this keeps
      # fastlane's window comfortably inside the job timeout, so it fails
      # cleanly on its own terms instead of being terminated.
      screenshot_processing_timeout: SCREENSHOT_PROCESSING_TIMEOUT,
      force: true
    )

    UI.important("==> Screenshots: upload complete")
  end
end
