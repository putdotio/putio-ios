{
  "name": "putio-apple-tooling",
  "private": true,
  "type": "module",
  "scripts": {
    "fonts:setup": "node scripts/sync-brand-fonts.ts",
    "fonts:check": "node scripts/sync-brand-fonts.ts --check",
    "markdown:check": "oxfmt --check \"**/*.md\"",
    "strings:android": "node scripts/string-catalog.ts android",
    "strings:check": "node scripts/string-catalog.ts --check",
    "tokens:generate": "node scripts/generate-design-tokens.ts",
    "tokens:check": "node scripts/generate-design-tokens.ts --check",
    "test": "node --test \"scripts/**/*.test.ts\"",
    "typecheck": "tsc --noEmit",
    "verify": "pnpm typecheck && pnpm test && pnpm tokens:check && pnpm fonts:check && pnpm strings:check && pnpm markdown:check"
  },
  "devDependencies": {
    "@putdotio/design": "4.0.1",
    "@types/node": "26.6.6",
    "@types/picomatch": "2.3.4",
    "oxfmt": "0.78.0",
    "picomatch": "2.3.1",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  },
  "packageManager": "pnpm@12.18.0"
}
